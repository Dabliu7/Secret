{
  "version": 3,
  "configurePresets": [
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/android-arm64",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-24",
        "ANDROID_STL": "c++_static",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    },
    {
      "name": "host",
      "displayName": "Host (testes, sem hooks)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MTASA_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "host", "configurePreset": "host" }
  ],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } }
  ]
}
